#!/bin/sh /etc/rc.common

# Copyright (C) 2026 iikira <iikira@users.noreply.github.com>
# SPDX-License-Identifier: MIT License
#
# procd init script for the simple-sing-box background daemon.
# Runs `sing-box run` in the foreground under procd supervision and
# optionally starts a second supervised instance that periodically pulls
# the subscription and reloads the config.

USE_PROCD=1
START=99

PROG="sing-box"
SUBSCRIBE_PROG="/usr/libexec/simple-sing-box-subscribe"
# The config file and working directory are fixed by this package and are not
# user-configurable via UCI.
CONFIG_FILE="/etc/simple-sing-box/config.json"
WORKING_DIRECTORY="/usr/share/simple-sing-box"
# Records the settings the running instances were built from, so a reload can
# skip restarting when nothing the service depends on has changed. Lives in
# tmpfs: it is rewritten on every start.
SETTINGS_FILE="/var/run/simple-sing-box.settings"

# The options the running instances actually depend on. Changing only
# subscribe_url or verify does NOT require a restart: the updater reads those on
# its next run and the running daemon is unaffected, so restarting would drop
# every connection for no reason.
settings_fingerprint() {
	config_load "simple-sing-box"
	local enabled log_stderr auto interval
	config_get_bool enabled "main" "enabled" "0"
	config_get_bool log_stderr "main" "log_stderr" "1"
	config_get_bool auto "main" "subscribe_auto_upgrade" "0"
	config_get interval "main" "subscribe_upgrade_interval_second" "0"
	printf '%s|%s|%s|%s' "$enabled" "$log_stderr" "$auto" "$interval"
}

start_service() {
	config_load "simple-sing-box"

	# Remember what we are starting from, so reload can tell whether anything
	# the instances depend on actually changed.
	settings_fingerprint > "$SETTINGS_FILE"

	local enabled
	local log_stderr
	local subscribe_auto_upgrade interval
	config_get_bool enabled "main" "enabled" "0"
	# When disabled, declare no instance. Any previously supervised instance
	# is torn down by `stop` in reload_service() below.
	[ "$enabled" -eq 1 ] || return 0

	config_get_bool log_stderr "main" "log_stderr" "1"

	# Ensure runtime directories exist so sing-box has a place to write.
	mkdir -p "$(dirname "$CONFIG_FILE")"
	mkdir -p "$WORKING_DIRECTORY"

	procd_open_instance "sing-box"
	procd_set_param command "$PROG" run -c "$CONFIG_FILE" -D "$WORKING_DIRECTORY"
	procd_set_param file "$CONFIG_FILE"
	procd_set_param stderr "$log_stderr"
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param respawn
	procd_close_instance

	# Optional subscription auto-update loop.
	config_get_bool subscribe_auto_upgrade "main" "subscribe_auto_upgrade" "0"
	config_get interval "main" "subscribe_upgrade_interval_second" "0"

	if [ "$subscribe_auto_upgrade" -eq 1 ] && [ "$interval" -gt 0 ] 2>/dev/null; then
		procd_open_instance "sing-box-subscribe"
		procd_set_param command "$SUBSCRIBE_PROG" loop "$interval"
		procd_set_param respawn
		procd_set_param stderr "1"
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "simple-sing-box"
}

# A UCI commit (or an explicit `reload`) lands here. Restart only when a setting
# the instances actually depend on changed; otherwise leave the running daemon
# alone, so an unrelated edit such as the subscription URL does not drop
# connections. When a restart IS needed, do a full stop+start so that disabling
# `enabled` (or changing the auto-upgrade interval) actually tears down the
# previously supervised instances. procd's `stop` does that cleanly — no killall.
reload_service() {
	local current
	current="$(settings_fingerprint)"
	if [ -f "$SETTINGS_FILE" ] && 	   [ "$(cat "$SETTINGS_FILE" 2>/dev/null)" = "$current" ]; then
		logger -t simple-sing-box -- "settings unchanged, not restarting"
		return 0
	fi
	stop
	start
}

# Manual one-shot subscription pull, callable from CLI or LuCI.
subscribe_once() {
	"$SUBSCRIBE_PROG" --once
}
